meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{host}}/api/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{name}}",
    "email": "{{email}}",
    "password": "{{password}}",
    "password_confirmation": "{{password}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
